{
  "name": "smartpos-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "shared",
    "gateway",
    "wallet",
    "dashboard"
  ],
  "scripts": {
    "dev": "npm --workspace backend run dev",
    "build": "npm --workspace backend run build",
    "start": "npm --workspace backend run start",
    "typecheck": "npm --workspace backend run typecheck",
    "lint": "npm --workspace backend run lint",
    "format": "npm --workspace backend run format"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "dependencies": {
    "viem": "^2.55.16"
  }
}
