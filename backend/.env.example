##############################################
# VAULT (Optional - for production secrets)
##############################################

VAULT_ADDR=

VAULT_TOKEN=

##############################################
# BLOCKCHAIN (RPC & Signer)
##############################################

RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your_key

BROADCAST_PRIVATE_KEY=0x...

##############################################
# EXCHANGE PROVIDER (Crypto Liquidity/OTC)
##############################################

# Name of the exchange provider (e.g., "binance", "kraken", "otc", "custom")
EXCHANGE_PROVIDER_NAME=

# Base URL for the provider's API
EXCHANGE_PROVIDER_BASE_URL=

# API authentication credentials
EXCHANGE_PROVIDER_API_KEY=

EXCHANGE_PROVIDER_API_SECRET=

# Provider-specific endpoint mappings (if needed, can be stored in database)
# EXCHANGE_PROVIDER_ENDPOINTS={"getQuote": "/v1/quote", "buy": "/v1/orders"}

##############################################
# PAYMENT PROVIDER ACCOUNTS (Paystack, etc.)
##############################################

# Paystack Account 1 credentials
# Store actual secrets in Vault or use env var reference
PAYSTACK_ACCOUNT_1_SECRET_KEY=
PAYSTACK_ACCOUNT_1_PUBLIC_KEY=

# Paystack Account 2 credentials
PAYSTACK_ACCOUNT_2_SECRET_KEY=
PAYSTACK_ACCOUNT_2_PUBLIC_KEY=

# Additional accounts can be added via database
# No need to modify this file for each new account

##############################################
# FEATURE FLAGS & WORKERS
##############################################

USE_MOCK_CRYPTO_PROVIDER=false

ENABLE_CONFIRMATION_WORKER=true

ENABLE_RECONCILIATION_WORKER=true

CONFIRMATION_POLL_INTERVAL_MS=30000

RECONCILIATION_POLL_INTERVAL_MS=60000

