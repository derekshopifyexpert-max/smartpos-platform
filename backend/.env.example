##############################################
# QUIDAX
##############################################

# Quidax is the only active external crypto
# liquidity/exchange provider for SmartPOS.

QUIDAX_API_KEY=

QUIDAX_BASE_URL=https://openapi.quidax.io/exchange-open-api/api/v1

QUIDAX_ENVIRONMENT=sandbox

QUIDAX_TIMEOUT_MS=15000

# Internal secret used only between the Cloudflare Quidax webhook Worker and SmartPOS.
SMARTPOS_WEBHOOK_SECRET=


##############################################
# BLOCKCHAIN
##############################################

# Only required for SmartPOS-controlled
# blockchain operations that are actually
# implemented and enabled.

BLOCKCHAIN_RPC_URL=

BLOCKCHAIN_CHAIN_ID=

BLOCKCHAIN_CONFIRMATIONS_REQUIRED=2

BROADCAST_PRIVATE_KEY=


##############################################
# SETTLEMENT WORKERS
##############################################

ENABLE_CONFIRMATION_WORKER=true

ENABLE_RECONCILIATION_WORKER=true

CONFIRMATION_POLL_INTERVAL_MS=30000

RECONCILIATION_POLL_INTERVAL_MS=60000


##############################################
# APPLICATION FEATURES
##############################################

ENABLE_SWAGGER=true

ENABLE_METRICS=true

ENABLE_QUEUE=true

ENABLE_EMAIL=true

ENABLE_SMS=true

ENABLE_PUSH=true


##############################################
# EMAIL
##############################################

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM=


##############################################
# STORAGE
##############################################

AWS_ACCESS_KEY=

AWS_SECRET_KEY=

AWS_REGION=

AWS_BUCKET=

S3_BUCKET=


##############################################
# LOGGING
##############################################

LOG_LEVEL=info


##############################################
# FILE UPLOAD
##############################################

