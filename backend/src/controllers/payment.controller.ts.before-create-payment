import {
  FastifyReply,
  FastifyRequest
} from "fastify";

import PaymentService from "../services/payment.service.js";

export default class PaymentController {

  constructor(
    private readonly paymentService: PaymentService
  ) {}

  createPaymentIntent = async (
    request: FastifyRequest,
    reply: FastifyReply
  ) => {

    const payment =
      await this.paymentService.createPaymentIntent(
        request.body as any
      );

    return reply.code(201).send({
      success: true,
      message: "Payment Intent Created",
      data: payment
    });
  };

  listPaymentIntents = async (
    request: FastifyRequest,
    reply: FastifyReply
  ) => {

    const {
      page = 1,
      limit = 10
    } = request.query as {
      page?: number;
      limit?: number;
    };

    const result =
      await this.paymentService.listPaymentIntents(
        Number(page),
        Number(limit)
      );

    return reply.send({
      success: true,
      data: result
    });
  };

  getPaymentIntent = async (
    request: FastifyRequest,
    reply: FastifyReply
  ) => {

    const { id } =
      request.params as {
        id: string;
      };

    const payment =
      await this.paymentService.getPaymentIntent(id);

    if (!payment) {
      return reply.code(404).send({
        success: false,
        message: "Payment Intent not found."
      });
    }

    return reply.send({
      success: true,
      data: payment
    });
  };

  expirePaymentIntent = async (
    request: FastifyRequest,
    reply: FastifyReply
  ) => {

    const { id } =
      request.params as {
        id: string;
      };

    const payment =
      await this.paymentService.expirePaymentIntent(id);

    return reply.send({
      success: true,
      data: payment
    });
  };

}
