NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartpos"
REDIS_URL="redis://127.0.0.1:6379"

JWT_SECRET="<KEEP-YOUR-EXISTING-JWT_SECRET>"
JWT_REFRESH_SECRET="<KEEP-YOUR-EXISTING-JWT_REFRESH_SECRET>"
JWT_EXPIRES_IN="7d"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

ENCRYPTION_KEY="<KEEP-YOUR-EXISTING-ENCRYPTION_KEY>"

# Internal secret shared by the Cloudflare webhook Worker and SmartPOS backend.
SMARTPOS_WEBHOOK_SECRET="<KEEP-YOUR-EXISTING-SMARTPOS_WEBHOOK_SECRET>"

# ============================================================
# FLUTTERWAVE
# ============================================================

# Flutterwave server-side API secret key.
# Used by the backend for hosted checkout, verification,
# refunds, and supported transfers.
FLUTTERWAVE_SECRET_KEY="<YOUR-FLUTTERWAVE-SECRET-KEY>"

# Flutterwave webhook secret hash.
# Must match the secret hash configured in the Flutterwave
# Dashboard webhook settings.
FLUTTERWAVE_WEBHOOK_SECRET="<YOUR-FLUTTERWAVE-WEBHOOK-SECRET-HASH>"

# ============================================================
# IMPORTANT
# ============================================================
# Quidax is NOT used by the current payment architecture.
# Do NOT add:
#
# QUIDAX_API_KEY
# QUIDAX_PRIVATE_KEY
# QUIDAX_WEBHOOK_SECRET
#
# They are intentionally absent.
