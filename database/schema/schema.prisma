generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  phone                String?             @unique
  passwordHash         String?
  firstName            String
  lastName             String
  displayName          String?
  avatar               String?
  role                 UserRole            @default(VIEWER)
  status               UserStatus?
  lastLoginAt          DateTime?
  lastLoginIP          String?
  isActive             Boolean             @default(true)
  isVerified           Boolean             @default(false)
  isMFAEnabled         Boolean             @default(false)
  mfaSecret            String?
  backupCodes          Json?
  passwordResetToken   String?             @unique
  passwordResetExpires DateTime?
  emailVerifyToken     String?             @unique
  emailVerifyExpires   DateTime?
  deletedAt            DateTime?
  merchantId           String?
  assignedRoleId       String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  activityLogs         ActivityLog[]       @relation("UserActivity")
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]          @relation("UserAuditLog")
  emailVerifications   EmailVerification[]
  employee             Employee?
  loginHistory         LoginHistory[]
  notifications        Notification[]      @relation("UserNotification")
  oauthAccounts        OAuthAccount[]
  passwordResets       PasswordReset[]
  refreshTokens        RefreshToken[]
  sessions             Session[]
  assignedRole         Role?               @relation(fields: [assignedRoleId], references: [id])
  merchant             Merchant?           @relation(fields: [merchantId], references: [id])
  userPermissions      UserPermission[]

  @@index([email])
  @@index([phone])
  @@index([merchantId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([assignedRoleId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  replacedBy String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String
  ipAddress  String?
  userAgent  String?
  deviceInfo Json?
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id          String        @id @default(cuid())
  name        String
  keyHash     String        @unique
  userId      String
  merchantId  String?
  permissions Json
  status      ApiKeyStatus  @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  revokedAt   DateTime?
  merchant    Merchant?     @relation(fields: [merchantId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage       ApiKeyUsage[]

  @@index([userId])
  @@index([merchantId])
  @@index([keyHash])
  @@index([status])
}

model ApiKeyUsage {
  id             String   @id @default(cuid())
  apiKeyId       String
  endpoint       String
  method         String
  ipAddress      String?
  userAgent      String?
  responseStatus Int
  responseTime   Int
  createdAt      DateTime @default(now())
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt(sort: Desc)])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  resource        String
  action          PermissionType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           RolePermission[]
  userPermissions UserPermission[]

  @@index([name])
  @@index([resource, action])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([name])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  grantedBy    String?
  grantedAt    DateTime   @default(now())
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model OAuthAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  email        String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  location      String?
  success       Boolean
  failureReason String?
  deviceId      String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Merchant {
  id                           String                        @id @default(cuid())
  name                         String
  legalName                    String?
  businessType                 String
  registrationNumber           String?                       @unique
  taxId                        String?
  email                        String                        @unique
  phone                        String?                       @unique
  website                      String?
  timezone                     String                        @default("UTC")
  currency                     CurrencyType                  @default(USD)
  status                       MerchantStatus                @default(PENDING)
  description                  String?
  logo                         String?
  contactEmail                 String?
  contactPhone                 String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  country                      String?
  isVerified                   Boolean                       @default(false)
  deletedAt                    DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  activityLogs                 ActivityLog[]                 @relation("MerchantActivity")
  apiKeys                      ApiKey[]
  auditLogs                    AuditLog[]                    @relation("MerchantAuditLog")
  bankAccounts                 BankAccount[]
  brands                       Brand[]
  cardTokens                   CardToken[]
  categories                   Category[]
  chargebacks                  Chargeback[]
  complianceLogs               ComplianceLog[]
  complianceReviews            ComplianceReview[]
  cryptoConversions            CryptoConversion[]
  customers                    Customer[]
  dashboardWidgets             DashboardWidget[]
  departments                  Department[]
  disputes                     Dispute[]
  employees                    Employee[]
  exchangeOrders               ExchangeOrder[]
  gatewayLogs                  GatewayLog[]
  inventory                    Inventory[]
  kyc                          Kyc?
  liquidityPools               LiquidityPool[]
  merchantAddresses            MerchantAddress[]
  merchantBranding             MerchantBranding?
  merchantBusinessHours        MerchantBusinessHours[]
  merchantCompliance           MerchantCompliance?
  merchantContacts             MerchantContact[]
  merchantDocuments            MerchantDocument[]
  merchantFeatures             MerchantFeature[]
  merchantFees                 MerchantFee[]
  merchantLimits               MerchantLimits?
  merchantNotificationSettings MerchantNotificationSettings?
  merchantSecuritySettings     MerchantSecuritySettings?
  merchantSettings             MerchantSettings?
  merchantSubscription         MerchantSubscription?
  merchantWebhookSettings      MerchantWebhookSettings?
  notifications                Notification[]                @relation("MerchantNotification")
  paymentIntents               PaymentIntent[]
  paymentMethods               PaymentMethod[]
  paymentProviderAccounts      PaymentProviderAccount[] @relation("MerchantPaymentProviderAccounts")
  payrolls                     Payroll[]
  products                     Product[]
  purchases                    Purchase[]
  receiptTemplates             ReceiptTemplate[]
  refunds                      Refund[]
  refundReasons                RefundReason[]
  reports                      Report[]
  settlements                  Settlement[]
  settlementBatches            SettlementBatch[]
  settlementRules              SettlementRule[]
  settlementSchedules          SettlementSchedule[]
  suppliers                    Supplier[]
  systemSettings               SystemSetting[]
  terminals                    Terminal[]
  terminalGroups               TerminalGroup[]
  transactions                 Transaction[]
  transakTransactions          TransakTransaction[]
  users                        User[]
  wallets                      Wallet[]
  walletTransfers              WalletTransfer[]
  webhooks                     Webhook[]
  webhookEvents                WebhookEvent[]

  @@index([email])
  @@index([phone])
  @@index([registrationNumber])
  @@index([status])
  @@index([deletedAt])
}

model MerchantSettings {
  id                       String       @id @default(cuid())
  merchantId               String       @unique
  receiptFooter            String?
  receiptLogo              String?
  autoSettlement           Boolean      @default(true)
  settlementThreshold      Decimal?     @db.Decimal(18, 4)
  defaultCurrency          CurrencyType @default(USD)
  timezone                 String       @default("UTC")
  language                 String       @default("en")
  ipWhitelist              Json?
  maxTransactionAmount     Decimal?     @db.Decimal(18, 4)
  minTransactionAmount     Decimal?     @db.Decimal(18, 4)
  allowRefunds             Boolean      @default(true)
  allowChargebacks         Boolean      @default(true)
  allowPartialSettlement   Boolean      @default(false)
  settlementAccountId      String?
  defaultGatewayProviderId String?
  metadata                 Json?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  merchant                 Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantBranding {
  id             String   @id @default(cuid())
  merchantId     String   @unique
  companyName    String?
  logo           String?
  favicon        String?
  primaryColor   String?
  secondaryColor String?
  font           String?
  emailFooter    String?
  receiptHeader  String?
  receiptFooter  String?
  invoiceLogo    String?
  website        String?
  socialLinks    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantSubscription {
  id              String             @id @default(cuid())
  merchantId      String             @unique
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now())
  expiryDate      DateTime?
  trialEndsAt     DateTime?
  autoRenew       Boolean            @default(false)
  amount          Decimal?           @db.Decimal(18, 4)
  currency        CurrencyType       @default(USD)
  paymentMethod   String?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  featureLimits   Json?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  merchant        Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantFeature {
  id          String   @id @default(cuid())
  merchantId  String
  featureName String
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, featureName])
  @@index([merchantId])
}

model MerchantLimits {
  id                      String   @id @default(cuid())
  merchantId              String   @unique
  dailyTransactionLimit   Decimal? @db.Decimal(18, 4)
  weeklyTransactionLimit  Decimal? @db.Decimal(18, 4)
  monthlyTransactionLimit Decimal? @db.Decimal(18, 4)
  dailyTransactionCount   Int?
  weeklyTransactionCount  Int?
  monthlyTransactionCount Int?
  perTransactionMax       Decimal? @db.Decimal(18, 4)
  perTransactionMin       Decimal? @db.Decimal(18, 4)
  settlementLimit         Decimal? @db.Decimal(18, 4)
  cryptoConversionLimit   Decimal? @db.Decimal(18, 4)
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  merchant                Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantFee {
  id         String       @id @default(cuid())
  merchantId String
  name       String
  type       String
  amount     Decimal?     @db.Decimal(18, 4)
  rate       Decimal?     @db.Decimal(18, 6)
  currency   CurrencyType @default(USD)
  appliesTo  String?
  isActive   Boolean      @default(true)
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([isActive])
}

model MerchantCompliance {
  id                  String    @id @default(cuid())
  merchantId          String    @unique
  riskLevel           RiskLevel @default(LOW)
  amlStatus           AMLStatus @default(CLEAR)
  kycStatus           KycStatus @default(NOT_STARTED)
  lastReviewDate      DateTime?
  nextReviewDate      DateTime?
  pepCheck            Boolean   @default(false)
  sanctionsCheck      Boolean   @default(false)
  restrictedCountries Json?
  notes               String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  merchant            Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantDocument {
  id                 String    @id @default(cuid())
  merchantId         String
  type               String
  name               String
  fileUrl            String
  verificationStatus String
  rejectionReason    String?
  uploadedAt         DateTime  @default(now())
  verifiedAt         DateTime?
  expiresAt          DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantContact {
  id         String   @id @default(cuid())
  merchantId String
  firstName  String
  lastName   String
  email      String
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantAddress {
  id           String   @id @default(cuid())
  merchantId   String
  type         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantBusinessHours {
  id         String   @id @default(cuid())
  merchantId String
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
}

model MerchantNotificationSettings {
  id                   String   @id @default(cuid())
  merchantId           String   @unique
  emailNotifications   Boolean  @default(true)
  smsNotifications     Boolean  @default(false)
  pushNotifications    Boolean  @default(false)
  webhookNotifications Boolean  @default(false)
  transactionEmails    Boolean  @default(true)
  settlementEmails     Boolean  @default(true)
  securityEmails       Boolean  @default(true)
  promotionalEmails    Boolean  @default(false)
  complianceEmails     Boolean  @default(true)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantSecuritySettings {
  id                    String   @id @default(cuid())
  merchantId            String   @unique
  mfaRequired           Boolean  @default(false)
  passwordPolicy        Json?
  sessionTimeout        Int      @default(3600)
  ipWhitelistEnabled    Boolean  @default(false)
  ipWhitelist           Json?
  webhookSecret         String?
  apiKeyRotationDays    Int      @default(90)
  auditLogRetentionDays Int      @default(365)
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantWebhookSettings {
  id         String   @id @default(cuid())
  merchantId String   @unique
  url        String
  secret     String?
  events     Json
  enabled    Boolean  @default(true)
  retryCount Int      @default(3)
  retryDelay Int      @default(60)
  timeout    Int      @default(30)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Terminal {
  id                    String                 @id @default(cuid())
  merchantId            String
  serialNumber          String                 @unique
  model                 String
  manufacturer          String
  firmwareVersion       String?
  softwareVersion       String?
  status                TerminalStatus         @default(OFFLINE)
  location              String?
  ipAddress             String?
  macAddress            String?
  lastHeartbeatAt       DateTime?
  lastBootAt            DateTime?
  lastTransactionAt     DateTime?
  batteryLevel          Int?
  storageUsed           Int?
  memoryUsed            Int?
  terminalGroupId       String?
  isActive              Boolean                @default(true)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cashDrawer            CashDrawer?
  device                Device?
  printer               Printer?
  scanner               Scanner?
  merchant              Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  terminalGroup         TerminalGroup?         @relation(fields: [terminalGroupId], references: [id])
  terminalConfiguration TerminalConfiguration?
  heartbeats            TerminalHeartbeat[]
  terminalKeys          TerminalKey[]
  terminalLocations     TerminalLocation[]
  terminalLogs          TerminalLog[]
  terminalSoftware      TerminalSoftware[]
  transactions          Transaction[]

  @@index([merchantId])
  @@index([serialNumber])
  @@index([status])
  @@index([terminalGroupId])
  @@index([deletedAt])
}

model TerminalGroup {
  id          String     @id @default(cuid())
  name        String
  merchantId  String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  terminals   Terminal[]
  merchant    Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, name])
  @@index([merchantId])
}

model TerminalConfiguration {
  id                     String       @id @default(cuid())
  terminalId             String       @unique
  receiptHeader          String?
  receiptFooter          String?
  currency               CurrencyType @default(USD)
  timezone               String       @default("UTC")
  language               String       @default("en")
  printerEnabled         Boolean      @default(true)
  autoPrint              Boolean      @default(true)
  signatureRequired      Boolean      @default(false)
  tipsEnabled            Boolean      @default(false)
  tipPercentages         Json?
  cashbackEnabled        Boolean      @default(false)
  cashbackLimit          Decimal?     @db.Decimal(18, 4)
  offlineMode            Boolean      @default(false)
  maxOfflineTransactions Int          @default(100)
  settlementSchedule     String?
  gatewayOverride        String?
  theme                  String?
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  terminal               Terminal     @relation(fields: [terminalId], references: [id], onDelete: Cascade)
}

model TerminalKey {
  id         String    @id @default(cuid())
  terminalId String
  keyType    String
  keyHash    String    @unique
  label      String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  terminal   Terminal  @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId])
  @@index([keyHash])
}

model TerminalHeartbeat {
  id            String         @id @default(cuid())
  terminalId    String
  status        TerminalStatus
  uptime        Int?
  battery       Int?
  memoryUsage   Int?
  cpuUsage      Int?
  storageFree   Int?
  networkStatus String?
  ipAddress     String?
  geolocation   Json?
  metadata      Json?
  createdAt     DateTime       @default(now())
  terminal      Terminal       @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId])
  @@index([createdAt(sort: Desc)])
}

model TerminalLog {
  id         String   @id @default(cuid())
  terminalId String
  level      LogLevel @default(INFO)
  message    String
  stackTrace String?
  metadata   Json?
  createdAt  DateTime @default(now())
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId])
  @@index([createdAt(sort: Desc)])
  @@index([level])
}

model TerminalSoftware {
  id           String   @id @default(cuid())
  terminalId   String
  version      String
  releaseNotes String?
  installedAt  DateTime @default(now())
  status       String
  checksum     String?
  fileUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  terminal     Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@unique([terminalId, version])
  @@index([terminalId])
}

model TerminalLocation {
  id         String   @id @default(cuid())
  terminalId String
  storeName  String?
  address    String?
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  city       String?
  state      String?
  country    String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId])
}

model Device {
  id           String           @id @default(cuid())
  terminalId   String?          @unique
  name         String
  type         String
  model        String?
  serialNumber String?          @unique
  status       DeviceStatusEnum @default(CONNECTED)
  ipAddress    String?
  port         Int?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  terminal     Terminal?        @relation(fields: [terminalId], references: [id])

  @@index([terminalId])
  @@index([serialNumber])
}

model Printer {
  id           String   @id @default(cuid())
  terminalId   String   @unique
  type         String
  paperSize    String?
  characterSet String?
  autoCut      Boolean  @default(true)
  lineSpacing  Int?
  printSpeed   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  terminal     Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
}

model Scanner {
  id           String   @id @default(cuid())
  terminalId   String   @unique
  type         String
  model        String?
  resolution   String?
  scanningMode String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  terminal     Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
}

model CashDrawer {
  id         String    @id @default(cuid())
  terminalId String    @unique
  status     String
  openCount  Int       @default(0)
  lastOpenAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  terminal   Terminal  @relation(fields: [terminalId], references: [id], onDelete: Cascade)
}

model ReceiptTemplate {
