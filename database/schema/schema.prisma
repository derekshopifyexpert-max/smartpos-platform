  @@index([terminalId])
  @@index([customerId])
  @@index([walletId])
  @@index([status])
  @@index([reference])
  @@index([gatewayTransactionId])
  @@index([createdAt(sort: Desc)])
  @@index([settlementStatus])
  @@index([paymentMethod])
  @@index([cryptoConversionId])
  @@index([paymentIntentId])
}

