model PaymentProviderAccount {
  id              String                       @id @default(cuid())
  name            String                       @unique
  displayName     String
  provider        String // e.g., "PAYSTACK", "FLUTTERWAVE", "STRIPE"
  currency        String // e.g., "NGN", "USD", "GHS"
  merchantId      String? // Optional: if set, account is merchant-specific; if null, system-wide
  status          PaymentProviderAccountStatus @default(NOT_CONFIGURED)
  secretKeyRef    String? // Reference to vault/secret storage (not actual key)
  publicKey       String? // Can be public (Paystack public key is non-sensitive)
  metadata        Json? // Additional config (webhooks URL, etc.)
  isDefault       Boolean                      @default(false)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  deletedAt       DateTime?
  merchant        Merchant? @relation("MerchantPaymentProviderAccounts", fields: [merchantId], references: [id], onDelete: SetNull)
  paymentIntents  PaymentIntent[]
  paymentAttempts PaymentAttempt[]

  @@index([provider])
  @@index([status])
  @@index([currency])
  @@index([isDefault])
  @@index([merchantId])
}
