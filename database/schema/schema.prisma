  walletId                String?
  amount                  Decimal                    @db.Decimal(18, 4)
  currency                CurrencyType               @default(USD)
  status                  TransactionStatus          @default(INITIATED)
  type                    String
  reference               String?                    @unique
  idempotencyKey          String?                    @unique
  description             String?
  gatewayTransactionId    String?
  gatewayProvider         String?
  approvalCode            String?
  paymentMethod           String
  cardBrand               CardBrand?
  cardLastFour            String?
  cardExpiry              String?
  authCode                String?
  customerIP              String?
  customerUserAgent       String?
  metadata                Json?
  feeAmount               Decimal?                   @db.Decimal(18, 4)
  feeCurrency             CurrencyType?
  netAmount               Decimal?                   @db.Decimal(18, 4)
  settlementStatus        SettlementStatus           @default(PENDING)
  settlementAmount        Decimal?                   @db.Decimal(18, 4)
  settlementCurrency      CurrencyType?
  settlementDate          DateTime?
  cryptoConversionId      String?
  cryptoAmount            Decimal?                   @db.Decimal(36, 18)
  cryptoCurrency          CurrencyType?
  blockchainTransactionId String?                    @unique
  paymentIntentId         String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  auditLogs               AuditLog[]                 @relation("TransactionAuditLog")
  authorization           Authorization?
  capture                 Capture?
  cardPayment             CardPayment?
  chargebacks             Chargeback[]
  commissions             Commission[]
  cryptoConversions       CryptoConversion[]         @relation("CryptoConversionTransaction")
  disputes                Dispute[]
  gatewayRequest          GatewayRequest?
  paymentAttempts         PaymentAttempt[]
  refunds                 Refund[]
  reversal                Reversal?
  blockchainTransaction   BlockchainTransaction?     @relation(fields: [blockchainTransactionId], references: [id])
  cryptoConversion        CryptoConversion?          @relation("TransactionCryptoConversion", fields: [cryptoConversionId], references: [id])
  customer                Customer?                  @relation(fields: [customerId], references: [id])
  merchant                Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentIntent           PaymentIntent?             @relation(fields: [paymentIntentId], references: [id])
  terminal                Terminal?                  @relation(fields: [terminalId], references: [id])
  wallet                  Wallet?                    @relation(fields: [walletId], references: [id])
  discounts               TransactionDiscount[]
  events                  TransactionEvent[]
  fees                    TransactionFee[]
  items                   TransactionItem[]
  metadataRecords         TransactionMetadata[]
  statusHistory           TransactionStatusHistory[]
  taxes                   TransactionTax[]
  timeline                TransactionTimeline[]
  voidTransaction         VoidTransaction?
