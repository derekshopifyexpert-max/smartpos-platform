model Wallet {
  id         String    @id @default(cuid())
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name     String
  type     WalletType   @default(CRYPTO)
  currency CurrencyType @default(USD)

  balance          Decimal @default(0) @db.Decimal(18, 8)
  reservedBalance  Decimal @default(0) @db.Decimal(18, 8)
  availableBalance Decimal @default(0) @db.Decimal(18, 8)

  status WalletStatus @default(ACTIVE)

  address String?

  blockchainId String?
  blockchain   BlockchainNetwork? @relation(fields: [blockchainId], references: [id], onDelete: SetNull)

  encryptedPrivateKey String?
  publicKey           String?

  bankAccountId String?      @unique
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances               WalletBalance[]
  walletAddresses        WalletAddress[]
  walletKeys             WalletKey[]
  walletAudits           WalletAudit[]
  settlements            Settlement[]
  transactionFees        TransactionFee[]
  transactions           Transaction[]
  blockchainTransactions BlockchainTransaction[]
  walletTransfers        WalletTransfer[]        @relation("FromWallet")
  incomingTransfers      WalletTransfer[]        @relation("ToWallet")

  @@index([merchantId])
  @@index([currency])
  @@index([type])
  @@index([address])
  @@index([blockchainId])
}

